# Copy to .env_secret (gitignored) and fill in. Compose passes every variable here into the container.
# AWS (used by awscli / terraform / SDKs inside the container)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# Optional: a named profile instead of static keys
# AWS_PROFILE=
# Venue / third-party API keys Claude may need for e2e work
# BITSTAMP_API_KEY=
# BITSTAMP_API_SECRET=
